# Local-only configuration. Copy to backend/.env and change SESSION_SECRET.
# Generate a value with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me-to-a-long-random-string
# Optional: defaults to backend/data/app.db
# DATABASE_URL=sqlite:///./data/app.db
# Origins allowed to send mutating requests (the Vite dev server).
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
